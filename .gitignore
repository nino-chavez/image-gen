.env
.DS_Store
.playwright-mcp/
node_modules/
output/

# refs/ is the drop directory for reference images fed to the generators.
# This repo is public, so it is ignore-by-default: personal photographs used as
# likeness anchors must never be committed here. Tracked reference assets are
# explicit opt-in below, one negation per file.
refs/*
!refs/flickday-logo-ref.png

# renderString writes this beside a template so relative paths resolve;
# it is removed on exit, but not after a hard kill.
.image-gen-render-*
